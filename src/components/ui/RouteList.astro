---
/**
 * A flat list of routes, newest first: one line each with the title, the date
 * and the reading time (articles) or "app" (standalone apps). Used by Pages (/)
 * and Apps (/apps/). Apps open in a new tab: they have no way back to the site.
 */
import { routeHref, type SiteRoute } from '@/config/routes';

interface Props { routes: SiteRoute[] }
const routes = [...Astro.props.routes].sort((a, b) => b.updated.localeCompare(a.updated));
const thisYear = new Date().getUTCFullYear();
const fmt = (d: string) => {
  const date = new Date(d);
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', ...(date.getUTCFullYear() !== thisYear ? { year: 'numeric' } : {}), timeZone: 'UTC' });
};
const extra = (r: SiteRoute) => (r.kind === 'standalone' ? 'app' : r.readMin ? `${r.readMin} min` : '');
---

<ul role="list" class="list">
  {routes.map((r) => (
    <li>
      <a class="row" href={routeHref(r)} data-sound-hover="risingPops" title={r.description} {...(r.kind === 'standalone' ? { target: '_blank', rel: 'noopener' } : {})}>
        <span class="title">{r.title}</span>
        <span class="meta">
          <time datetime={r.updated}>{fmt(r.updated)}</time>
          {extra(r) && <span class="extra">· {extra(r)}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .list { display: flex; flex-direction: column; gap: 4px; max-width: 820px; }
  .row {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px;
    padding: 8px 0;
    text-decoration: none; color: var(--color-text);
    opacity: 0.72; transition: opacity 180ms ease;
  }
  .row:hover, .row:focus-visible { opacity: 1; }
  .title { font-size: 1.375rem; font-weight: var(--font-weight-medium); line-height: 1.3; }
  .meta { display: inline-flex; gap: 6px; font-size: 0.9375rem; color: var(--color-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 640px) { .title { font-size: 1.1875rem; } }
</style>
