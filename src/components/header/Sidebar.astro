---
/**
 * Site-wide left sidebar, chat-app style: name and collapse button, the main
 * links, "On this page" (the page's contents or its <Tabs page> sections), and
 * recently updated pages.
 *
 * Collapse hides it completely; the expand button then sits in the top bar
 * (Header). The choice is kept in localStorage ('sidebar') and applied before
 * first paint (BaseLayout). Under 960px it is a drawer over the page, closed by
 * default, opened from the top bar.
 *
 * Slot "page": the page's own section list (ArticleLayout's contents).
 */
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV } from '@/config/site';
import { unbase } from '@/lib/base';

// Without the base (/dev/learn/ -> /learn/), so it compares with NAV's site paths.
const path = unbase(Astro.url.pathname);
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Recently updated articles. Read the raw MDX, not the modules: importing every page
// from a component every page uses would be an import cycle (see @/config/routes).
const sources = import.meta.glob<string>('/src/pages/*/index.mdx', { query: '?raw', import: 'default', eager: true });
const fm = (src: string, key: string) => src.match(new RegExp(`^${key}:\\s*"?(.*?)"?\\s*$`, 'm'))?.[1] ?? '';
const recent = Object.entries(sources)
  .map(([p, src]) => ({ href: `/${p.split('/').at(-2)}/`, title: fm(src, 'title'), updated: fm(src, 'updated') }))
  .filter((r) => r.title && /^\d{4}-\d{2}-\d{2}$/.test(r.updated) && r.href !== '/showcase/' && r.href !== '/about/')
  .sort((a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title))
  .slice(0, 10);

const ICONS: Record<string, string> = {
  '/': '<path d="M4 5h16M4 10h16M4 15h10M4 20h7"/>',
  '/learn/': '<path d="M3 7l9-4 9 4-9 4-9-4Z"/><path d="M7 9v5c0 1.7 2.2 3 5 3s5-1.3 5-3V9"/>',
  '/apps/': '<rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><rect x="14" y="14" width="6" height="6" rx="1.5"/>',
  '/glossary/': '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Z"/><path d="M5 17a3 3 0 0 1 3-3h11"/>',
  '/about/': '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
};
/** hasPage: the layout filled the "page" slot (a forwarded empty slot still counts as present). */
interface Props { hasPage?: boolean }
const { hasPage = false } = Astro.props;
---

<aside class="sb" id="sidebar" aria-label="Site navigation" data-sidebar>
  <div class="sb-head">
    <Search />
    <ThemeToggle />
    <a class="sb-btn" href="/settings/" title="Settings" aria-current={path === '/settings/' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
      <span class="visually-hidden">Settings</span>
    </a>
    <button type="button" class="sb-btn" data-sidebar-toggle aria-controls="sidebar" aria-expanded="true" title="Close sidebar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M9 4v16" /></svg>
      <span class="visually-hidden">Close sidebar</span>
    </button>
  </div>

  <div class="sb-scroll">
    <nav aria-label="Main">
      <ul role="list" class="sb-nav">
        {NAV.map((l) => (
          <li>
            <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[l.href] ?? '<circle cx="12" cy="12" r="3"/>'} />
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="sb-sec sb-page" data-sidebar-page hidden={!hasPage}>
      <p class="sb-label" data-sidebar-page-label>On this page</p>
      <div data-sidebar-page-body><slot name="page" /></div>
    </section>

    {recent.length > 0 && (
      <section class="sb-sec">
        <p class="sb-label">Recent</p>
        <ul role="list" class="sb-recent">
          {recent.map((r) => (
            <li><a href={r.href} title={r.title} aria-current={path === r.href ? 'page' : undefined}>{r.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</aside>
<div class="sb-backdrop" data-sidebar-backdrop hidden></div>

<style is:global>
  :root { --sidebar-width: 272px; }
  .sb {
    position: fixed; inset: 0 auto 0 0; z-index: var(--z-toc);
    width: var(--sidebar-width); display: flex; flex-direction: column;
    background: var(--color-blurred-background); border-right: 1px solid var(--color-gray-100);
    transition: transform 260ms var(--ease-out), visibility 260ms;
  }
  html[data-sidebar='collapsed'] .sb { transform: translateX(-100%); visibility: hidden; }
  /* Tools in one row, top left; the close button at the row's end. */
  .sb-head { display: flex; align-items: center; gap: 4px; height: 60px; padding: 0 10px 0 14px; flex: none; }
  /* Search uses the shared round IconButton; draw it like the other tools here. */
  .sb-head :is(.search-trigger, .theme-toggle) { width: 36px; height: 36px; border-radius: 0; color: var(--color-gray-700); }
  .sb-head :is(.search-trigger, .theme-toggle)::before { display: none; }
  .sb-head :is(.search-trigger, .theme-toggle):hover { color: var(--color-primary); background: var(--color-cloud-100); }
  .sb-head :is(.search-trigger, .theme-toggle) svg { width: 20px; height: 20px; stroke-width: 1.8; }
  .sb-btn[aria-current='page'] { color: var(--color-primary); background: var(--color-info-background); }
  .sb-head [data-sidebar-toggle] { margin-left: auto; }
  .sb-btn, .tbar-btn { display: grid; place-content: center; width: 36px; height: 36px; border-radius: 0; color: var(--color-gray-700); transition: color 150ms, background 150ms; flex: none; }
  .sb-btn:hover, .tbar-btn:hover { color: var(--color-primary); background: var(--color-cloud-100); }
  .sb-btn svg, .tbar-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sb-scroll { flex: 1; overflow-y: auto; padding: 4px 10px 24px; overscroll-behavior: contain; }
  .sb-nav a, .sb-recent a, .sb-all {
    display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 0;
    color: var(--color-text); text-decoration: none; font-size: 0.9375rem; line-height: 1.3;
  }
  .sb-nav a:hover, .sb-recent a:hover { background: var(--color-cloud-100); }
  .sb-nav a[aria-current='page'], .sb-recent a[aria-current='page'] { background: var(--color-info-background); color: var(--color-primary); font-weight: var(--font-weight-medium); }
  .sb-nav svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .sb-sec { margin-top: 20px; }
  .sb-sec[hidden] { display: none; }
  .sb-label { padding: 0 10px 6px; font-size: 0.8rem; color: var(--color-muted); }
  .sb-recent a { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.875rem; padding: 6px 10px; }
  .sb-all { font-size: 0.8125rem; color: var(--color-muted); padding: 6px 10px; }
  .sb-all:hover { color: var(--color-primary); }
  .sb-backdrop { position: fixed; inset: 0; z-index: calc(var(--z-toc) - 1); background: rgb(10 12 16 / 0.35); }
  .sb-backdrop[hidden] { display: none; }

  /* The page column moves over for the sidebar. */
  /* Extra gutter between the Sidebar (or the floating open button) and the page. */
  /* --shell-left: the page area starts this far from the left edge (diagrams use it to span the area). */
  :root { --shell-left: calc(var(--sidebar-width) + 28px); }
  html[data-sidebar='collapsed'] { --shell-left: 48px; }
  .shell { padding-left: var(--shell-left); transition: padding-left 260ms var(--ease-out); }

  @media (max-width: 960px) {
    :root, html[data-sidebar='collapsed'] { --shell-left: 0px; }
    .sb, html[data-sidebar='collapsed'] .sb { transform: translateX(-100%); visibility: hidden; box-shadow: var(--shadow-elevation-medium); background: var(--color-background); }
    html[data-sidebar-mobile='open'] .sb { transform: none; visibility: visible; }
  }
</style>

<script>
  import { url } from '@/lib/base';
  const root = document.documentElement;
  const narrow = matchMedia('(max-width: 960px)');
  const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
  const toggles = () => [...document.querySelectorAll<HTMLButtonElement>('[data-sidebar-toggle]')];
  const isOpen = () => (narrow.matches ? root.dataset.sidebarMobile === 'open' : root.dataset.sidebar !== 'collapsed');
  const sync = () => {
    const open = isOpen();
    for (const b of toggles()) {
      b.setAttribute('aria-expanded', String(open));
      b.title = open ? 'Close sidebar' : 'Open sidebar';
    }
    if (backdrop) backdrop.hidden = !(narrow.matches && open);
  };
  const set = (open: boolean) => {
    if (narrow.matches) root.dataset.sidebarMobile = open ? 'open' : '';
    else {
      root.dataset.sidebar = open ? '' : 'collapsed';
      try { localStorage.setItem('sidebar', open ? 'open' : 'collapsed'); } catch { /* storage off */ }
    }
    sync();
  };
  // Settings remembers where it was opened from (its close button returns there).
  const SETTINGS = url('/settings/');
  const rememberPage = () => {
    if (location.pathname === SETTINGS) return;
    try { sessionStorage.setItem('settings-return', location.href); } catch { /* storage off */ }
  };
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t.closest?.('[data-sidebar-toggle]')) set(!isOpen());
    else if (t === backdrop || (narrow.matches && t.closest?.('.sb a[href]'))) set(false);
    if (t.closest?.(`a[href="${SETTINGS}"]`)) rememberPage();
  });
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.key.toLowerCase() === 's') { e.preventDefault(); set(!isOpen()); }
    else if ((e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && e.key === ',') {
      // Ctrl/Cmd + , : open Settings (on Settings: close it, handled there).
      if (location.pathname === SETTINGS) return;
      e.preventDefault();
      rememberPage();
      location.href = SETTINGS;
    }
    else if (e.key === 'Escape' && narrow.matches && isOpen()) set(false);
  });
  narrow.addEventListener('change', sync);
  sync();
</script>
