---
/**
 * The only page chrome outside the Sidebar: a small floating button, top left,
 * that opens the Sidebar while it is closed (always on narrow screens).
 * There is no top bar; search and theme live in the Sidebar.
 */
---

<button type="button" class="sb-open" data-sidebar-toggle aria-controls="sidebar" aria-expanded="true" title="Open sidebar">
  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M9 4v16" /></svg>
  <span class="visually-hidden">Open sidebar</span>
</button>

<style>
  .sb-open {
    position: fixed; top: 12px; left: 12px; z-index: var(--z-header);
    display: grid; place-content: center; width: 38px; height: 38px; border-radius: 0;
    color: var(--color-gray-700); background: var(--color-background);
    border: 1px solid var(--color-gray-100);
    transition: color 150ms, background 150ms, opacity 200ms;
  }
  .sb-open:hover { color: var(--color-primary); background: var(--color-cloud-100); }
  .sb-open svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  /* Wide screens with the Sidebar open: the Sidebar's own button closes it. */
  :global(html:not([data-sidebar='collapsed'])) .sb-open { opacity: 0; pointer-events: none; }
  @media (max-width: 960px) { :global(html) .sb-open { opacity: 1 !important; pointer-events: auto !important; } }
</style>
