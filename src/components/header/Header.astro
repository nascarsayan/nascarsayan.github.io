---
/**
 * Simple sticky top bar: wordmark (home), a few links, search, sound and theme toggles.
 * Shared by every page, so it sits in normal flow
 * (no overlap tricks) and uses its own background.
 */
import Logo from '@/components/ui/Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import SoundToggle from './SoundToggle.astro';
import { NAV } from '@/config/site';

/** toc: the page has a contents rail; its toggle sits left of the name (ArticleLayout wires it). */
interface Props { toc?: boolean }
const { toc = false } = Astro.props;

const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="header-wrapper" data-header>
  <header class="site-header max-width-wrapper">
    <div class="brand">
      {toc && (
        <button type="button" class="toc-toggle" data-sound-click="popUpOn" data-toc-toggle aria-expanded="true" aria-controls="toc" title="Toggle contents">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16" /></svg>
          <span class="visually-hidden">Contents</span>
        </button>
      )}
      <Logo />
    </div>
    <nav class="nav" aria-label="Main">
      <ul role="list" class="nav-list">
        {NAV.map((l) => (
          <li><a class="nav-link" href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions"><Search /><SoundToggle /><ThemeToggle /></div>
  </header>
</div>

<style>
  .header-wrapper {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    transition: transform 320ms var(--ease-soft), box-shadow 200ms;
    height: var(--header-height);
    background: var(--color-blurred-background);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-gray-100);
    view-transition-name: site-header;
  }
  /* Hidden while scrolling down; back on scroll up or near the top. */
  .header-wrapper:global(.is-hidden) { transform: translateY(-100%); }
  .header-wrapper:global(.is-raised) { box-shadow: 0 1px 12px rgb(20 30 60 / 0.08); }
  .site-header { display: flex; align-items: center; gap: 32px; height: 100%; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .toc-toggle { display: grid; place-content: center; width: 36px; height: 36px; margin-left: -8px; border-radius: 8px; color: var(--color-gray-700); transition: color 150ms, background 150ms; }
  .toc-toggle:hover { color: var(--color-primary); background: var(--color-cloud-100); }
  .nav { flex: 1; }
  .actions { display: flex; align-items: center; gap: 14px; }
  .nav-list { display: flex; gap: 4px; }
  .nav-link {
    display: block;
    padding: 6px 12px;
    font-size: 1rem;
    text-decoration: none;
    color: var(--color-text);
    border-radius: 6px;
    transition: color 200ms;
  }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--color-primary); }
  @media (max-width: 500px) { .site-header { gap: 12px; } .nav-link { padding: 6px 8px; } }
  /* Narrow screens: name and actions on the first row, the nav links on a second row that scrolls
     sideways if it must. The taller bar sets --header-height, so sticky offsets below it follow. */
  @media (max-width: 720px) {
    :global(:root) { --header-height: 96px; }
    .site-header { flex-wrap: wrap; align-content: center; row-gap: 2px; }
    .brand { flex: 1; min-width: 0; }
    .nav { order: 3; flex: 1 0 100%; min-width: 0; overflow-x: auto; scrollbar-width: none; }
    .nav-list { margin-left: -8px; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-header]');
  if (bar) {
    let last = scrollY, raf = 0;
    const update = () => {
      raf = 0;
      const y = scrollY, dy = y - last;
      // Ignore small jitters; never hide near the top or while search is open.
      if (Math.abs(dy) > 6) {
        const hide = dy > 0 && y > 120 && !document.querySelector('dialog[open]');
        bar.classList.toggle('is-hidden', hide);
        last = y;
      }
      if (y < 20) bar.classList.remove('is-hidden');
      bar.classList.toggle('is-raised', y > 4);
      document.documentElement.classList.toggle('header-hidden', bar.classList.contains('is-hidden'));
    };
    addEventListener('scroll', () => { raf ||= requestAnimationFrame(update); }, { passive: true });
    bar.addEventListener('focusin', () => bar.classList.remove('is-hidden'));
    update();
  }
</script>
