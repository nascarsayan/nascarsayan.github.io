---
/**
 * A step-by-step worked example: one picture at a time, with its explanation.
 *
 *   <Walkthrough title="Attention on a 4-token prompt">
 *     <WStep title="1 · Tokens become vectors">
 *       <Matrix … />            (any content: matrices, diagrams, tables, code)
 *       Text that explains this step.
 *     </WStep>
 *     <WStep title="2 · …">…</WStep>
 *   </Walkthrough>
 *
 * Controls: previous / next / play, step dots, ← → keys when focused, and a
 * Stacked | Spread switch. Stacked (default): one card at a time, the rest
 * peeking out behind it, so it takes little room. Spread: every card one
 * after another (for reading top to bottom, printing and search). Without
 * JavaScript all cards show.
 */
interface Props { title?: string; caption?: string; id?: string }
const { title, caption, id } = Astro.props;
---

<section class="wt" id={id} data-walkthrough tabindex="0" aria-roledescription="walkthrough" aria-label={title}>
  <header class="wt-head">
    {title && <p class="wt-title">{title}</p>}
    <div class="wt-ctrl" role="group" aria-label="Steps">
      <span class="wt-nav">
        <button type="button" data-wt="prev" aria-label="Previous step" title="Previous (←)">‹</button>
        <span class="wt-count" aria-live="polite"></span>
        <button type="button" data-wt="next" aria-label="Next step" title="Next (→)">›</button>
        <button type="button" data-wt="play" aria-label="Play" title="Play">▶</button>
        <span class="wt-dots"></span>
      </span>
      <span class="wt-view" role="group" aria-label="View">
        <button type="button" data-wt-view="stacked" aria-pressed="true" title="One card at a time, the rest stacked behind it">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect class="c" x="6" y="1" width="9" height="7" rx="1.3" /><rect class="c" x="3.5" y="3.75" width="9" height="7" rx="1.3" /><rect class="c" x="1" y="6.5" width="9" height="7.5" rx="1.3" /></svg>Stacked
        </button>
        <button type="button" data-wt-view="spread" aria-pressed="false" title="Every card, one after another">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="1.5" width="12" height="5" rx="1.2" /><rect x="2" y="9.5" width="12" height="5" rx="1.2" /></svg>Spread
        </button>
      </span>
    </div>
  </header>
  <div class="wt-steps"><slot /></div>
  {caption && <p class="wt-caption">{caption}</p>}
</section>

<style>
  .wt { margin: 28px 0; padding: 16px 18px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; background: var(--color-background); }
  .wt:focus-visible { outline: 2px solid var(--color-primary); }
  .wt-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 12px; }
  .wt-title { font-weight: var(--font-weight-bold); }
  .wt-ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .wt-ctrl button { min-width: 32px; height: 32px; padding: 0 10px; border-radius: 999px; background: var(--color-cloud-100); color: var(--color-gray-800); font-size: 0.9375rem; }
  .wt-ctrl button:hover:not(:disabled) { color: var(--color-primary); }
  .wt-ctrl button:disabled { opacity: 0.4; }
  .wt-nav { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  /* Stacked | Spread: one outlined pill, like the diagram speed control. */
  .wt-view { display: inline-flex; overflow: hidden; border: 1px solid var(--color-gray-300); border-radius: 999px; }
  .wt-ctrl .wt-view button { display: inline-flex; align-items: center; gap: 6px; height: 30px; min-width: 0; padding: 0 12px; border-radius: 0; font-size: 0.8125rem; background: var(--color-background); }
  .wt-ctrl .wt-view button + button { border-left: 1px solid var(--color-gray-100); }
  .wt-ctrl .wt-view button[aria-pressed='true'] { color: var(--color-primary); background: var(--color-cloud-100); font-weight: var(--font-weight-medium); }
  .wt-view svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; }
  /* Overlapping cards: each one hides the one behind it. */
  .wt-view svg .c { fill: var(--color-background); }
  .wt-view button[aria-pressed='true'] svg .c { fill: var(--color-cloud-100); }
  .wt.is-all .wt-nav { display: none; }
  .wt-count { min-width: 44px; text-align: center; font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--color-muted); }
  .wt-dots { display: inline-flex; gap: 4px; }
  .wt-dots :global(button) { min-width: 10px; width: 10px; height: 10px; padding: 0; border-radius: 999px; background: var(--color-gray-300); }
  .wt-dots :global(button[aria-current='step']) { background: var(--color-primary); }
  .wt-caption { margin-top: 10px; font-size: 1rem; line-height: 1.55; color: var(--color-text); }
  .wt.is-js:not(.is-all) :global(.wt-step:not(.is-on)) { display: none; }
  /* Stacked: two card edges peek out under the frame (borders, no shadow). */
  .wt { position: relative; }
  .wt.is-js:not(.is-all) { margin-bottom: 40px; }
  .wt.is-js:not(.is-all)::before, .wt.is-js:not(.is-all)::after {
    content: ''; position: absolute; z-index: -1; height: 14px;
    border: 1px solid var(--color-gray-300); border-top: 0; border-radius: 0; background: var(--color-background);
  }
  .wt.is-js:not(.is-all)::before { left: 10px; right: 10px; bottom: -7px; }
  .wt.is-js:not(.is-all)::after { left: 22px; right: 22px; bottom: -13px; }
  .wt.is-all :global(.wt-step + .wt-step) { margin-top: 20px; padding-top: 16px; border-top: 1px dashed var(--color-gray-300); }
</style>

<script>
  // Stacked / Spread is one site-wide preference, kept in this browser (localStorage
  // 'wt-view'): choosing it in one walkthrough applies it to every walkthrough on every
  // page, and to other open tabs.
  const KEY = 'wt-view';
  const saved = () => { try { return localStorage.getItem(KEY) === 'spread' ? 'spread' : 'stacked'; } catch { return 'stacked'; } };
  const appliers: ((view: string) => void)[] = [];
  const applyAll = (view: string) => appliers.forEach((f) => f(view));
  addEventListener('storage', (e) => { if (e.key === KEY) applyAll(saved()); });
  for (const wt of document.querySelectorAll<HTMLElement>('[data-walkthrough]')) {
    const steps = [...wt.querySelectorAll<HTMLElement>(':scope > .wt-steps > .wt-step')];
    if (!steps.length) continue;
    wt.classList.add('is-js');
    const count = wt.querySelector<HTMLElement>('.wt-count')!;
    const dots = wt.querySelector<HTMLElement>('.wt-dots')!;
    const prev = wt.querySelector<HTMLButtonElement>('[data-wt=prev]')!;
    const next = wt.querySelector<HTMLButtonElement>('[data-wt=next]')!;
    const play = wt.querySelector<HTMLButtonElement>('[data-wt=play]')!;
    const views = [...wt.querySelectorAll<HTMLButtonElement>('[data-wt-view]')];
    let i = 0, timer = 0;
    const dotBtns = steps.map((s, k) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.ariaLabel = `Step ${k + 1}: ${s.dataset.title ?? ''}`;
      b.title = s.dataset.title ?? `Step ${k + 1}`;
      b.addEventListener('click', () => { stop(); go(k); });
      dots.append(b);
      return b;
    });
    const go = (k: number) => {
      i = Math.max(0, Math.min(steps.length - 1, k));
      steps.forEach((s, n) => s.classList.toggle('is-on', n === i));
      dotBtns.forEach((b, n) => (n === i ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current')));
      count.textContent = `${i + 1} / ${steps.length}`;
      prev.disabled = i === 0;
      next.disabled = i === steps.length - 1;
    };
    const stop = () => { clearInterval(timer); timer = 0; play.textContent = '▶'; play.ariaLabel = 'Play'; };
    prev.addEventListener('click', () => { stop(); go(i - 1); });
    next.addEventListener('click', () => { stop(); go(i + 1); });
    play.addEventListener('click', () => {
      if (timer) return stop();
      if (i === steps.length - 1) go(0);
      play.textContent = '❚❚'; play.ariaLabel = 'Pause';
      timer = window.setInterval(() => (i < steps.length - 1 ? go(i + 1) : stop()), 6000);
    });
    const apply = (view: string) => {
      const spread = view === 'spread';
      if (spread) stop();
      wt.classList.toggle('is-all', spread);
      views.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.wtView === view)));
    };
    appliers.push(apply);
    apply(saved());
    for (const v of views) v.addEventListener('click', () => {
      try { localStorage.setItem(KEY, v.dataset.wtView!); } catch { /* private mode: this page only */ }
      applyAll(v.dataset.wtView!);
    });
    wt.addEventListener('keydown', (e) => {
      if (e.target !== wt) return;
      if (e.key === 'ArrowRight') { stop(); go(i + 1); e.preventDefault(); }
      else if (e.key === 'ArrowLeft') { stop(); go(i - 1); e.preventDefault(); }
    });
    go(0);
  }
</script>
