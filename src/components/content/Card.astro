---
/** A titled box in a <Cards> grid: <Card title="Retry worker" tag="worker" tone="good">Markdown body.</Card> */
import './tones.css';
interface Props { title: string; tag?: string; tone?: 'note' | 'good' | 'warn' | 'risk' | 'neutral' | 'primary' }
const { title, tag, tone = 'neutral' } = Astro.props;
---

<section class:list={['card', `tone-${tone}`]}>
  {tag && <span class="tag">{tag}</span>}
  <h4>{title}</h4>
  <div class="body"><slot /></div>
</section>

<style>
  .card { padding: 14px 18px; border-radius: 0; background: var(--t-bg); border: 1px solid color-mix(in srgb, var(--t-fg) 40%, transparent); }
  .tag { display: inline-block; margin-bottom: 4px; font-size: 0.75rem; letter-spacing: 0.5px; text-transform: uppercase; color: var(--t-fg); }
  h4 { margin: 0 0 6px; font-size: 1rem; }
  .body { font-size: 0.9375rem; color: var(--color-gray-800); }
  .body :global(> :first-child) { margin-top: 0; }
  .body :global(> :last-child) { margin-bottom: 0; }
</style>
