{
 "name": "promql",
 "scopeName": "source.promql",
 "fileTypes": [
  "promql"
 ],
 "patterns": [
  {
   "include": "#comment"
  },
  {
   "include": "#string"
  },
  {
   "include": "#matchers"
  },
  {
   "name": "constant.numeric.duration.promql",
   "match": "\\b\\d+(?:ms|s|m|h|d|w|y)\\b"
  },
  {
   "name": "keyword.control.promql",
   "match": "\\b(?:by|without|on|ignoring|group_left|group_right|offset|bool|and|or|unless)\\b"
  },
  {
   "name": "support.function.promql",
   "match": "\\b(?:rate|irate|increase|delta|idelta|deriv|predict_linear|changes|resets|sum|avg|min|max|count|count_values|group|stddev|stdvar|topk|bottomk|quantile|limitk|limit_ratio|histogram_quantile|histogram_count|histogram_sum|histogram_fraction|label_replace|label_join|absent|absent_over_time|avg_over_time|min_over_time|max_over_time|sum_over_time|count_over_time|quantile_over_time|stddev_over_time|stdvar_over_time|last_over_time|present_over_time|mad_over_time|abs|ceil|floor|round|sqrt|exp|ln|log2|log10|clamp|clamp_min|clamp_max|scalar|vector|time|timestamp|sort|sort_desc|sort_by_label|sort_by_label_desc|sgn|day_of_month|day_of_week|day_of_year|days_in_month|hour|minute|month|year|info)(?=\\s*\\()"
  },
  {
   "name": "constant.numeric.promql",
   "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
  },
  {
   "name": "keyword.operator.promql",
   "match": "==|!=|>=|<=|=~|!~|[-+*/%^<>@]"
  },
  {
   "name": "variable.other.metric.promql",
   "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:]*\\b"
  }
 ],
 "repository": {
  "comment": {
   "name": "comment.line.number-sign.promql",
   "match": "#.*$"
  },
  "string": {
   "patterns": [
    {
     "name": "string.quoted.double.promql",
     "begin": "\"",
     "end": "\"",
     "patterns": [
      {
       "name": "constant.character.escape.promql",
       "match": "\\\\."
      }
     ]
    },
    {
     "name": "string.quoted.single.promql",
     "begin": "'",
     "end": "'"
    },
    {
     "name": "string.quoted.other.promql",
     "begin": "`",
     "end": "`"
    }
   ]
  },
  "matchers": {
   "begin": "\\{",
   "end": "\\}",
   "beginCaptures": {
    "0": {
     "name": "punctuation.section.braces.promql"
    }
   },
   "endCaptures": {
    "0": {
     "name": "punctuation.section.braces.promql"
    }
   },
   "patterns": [
    {
     "include": "#string"
    },
    {
     "name": "keyword.operator.promql",
     "match": "=~|!~|!=|="
    },
    {
     "name": "entity.name.tag.label.promql",
     "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
   ]
  }
 }
}