---
/** Simple content page: the title block + a single prose column. */
import '@/styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import Hero from '@/components/hero/Hero.astro';

/** Called directly with title/description, or as a Markdown `layout:` with frontmatter. */
interface Props { title?: string; description?: string; frontmatter?: { title: string; description?: string } }
const { title = Astro.props.frontmatter?.title ?? '', description = Astro.props.frontmatter?.description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Hero slot="hero"><Fragment slot="title">{title}</Fragment></Hero>
  <div class="max-width-wrapper body">
    <div class="prose"><slot /></div>
  </div>
</BaseLayout>

<style>
  .body { padding-top: 32px; padding-bottom: 40px; }
  .prose { max-width: 686px; }
</style>
