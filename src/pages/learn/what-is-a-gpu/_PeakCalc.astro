---
/**
 * Peak matrix throughput of an MI355X from its parts: CUs × FLOPs per clock per
 * CU (CDNA 4 white paper) × clock, and the FLOPs-per-byte balance against HBM.
 */
import { cus, hbmGBs } from './_chip';
const formats = [
  { id: 'bf16', label: 'BF16', perCU: 4096, bytes: 2 },
  { id: 'fp8', label: 'FP8', perCU: 8192, bytes: 1 },
  { id: 'mxfp4', label: 'MXFP4', perCU: 16384, bytes: 0.53125 },
];
---

<figure class="pk" data-pk={JSON.stringify({ formats, hbm: hbmGBs, cus })}>
  <figcaption class="pk-title">Peak throughput from the parts</figcaption>
  <div class="pk-in">
    <label>Number format <select data-k="f">{formats.map((f) => <option value={f.id} selected={f.id === 'fp8'}>{f.label} · {f.perCU.toLocaleString('en-US')} FLOPs/clock/CU</option>)}</select></label>
    <label>Clock <input data-k="clk" type="range" min="200" max="2400" step="100" value="2400" /> <output data-o="clk"></output></label>
  </div>
  <div class="pk-out">
    <div><span class="k">Peak matrix rate</span><span class="v" data-o="peak"></span></div>
    <div><span class="k">8192 × 8192 × 8192 matrix multiply at that peak</span><span class="v" data-o="mm"></span></div>
    <div><span class="k">FLOPs needed per byte read from HBM to keep up (8 TB/s)</span><span class="v" data-o="ridge"></span></div>
    <div><span class="k">Decode does about</span><span class="v" data-o="dec"></span></div>
  </div>
  <p class="pk-note" data-o="note"></p>
</figure>

<style>
  .pk { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 14px; }
  .pk-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .pk-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px 20px; font-size: 0.875rem; }
  .pk-in label { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .pk-in select, .pk-in input { accent-color: var(--color-primary); }
  .pk-in output { min-width: 70px; font-variant-numeric: tabular-nums; font-weight: 600; }
  .pk-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px 16px; margin-top: 14px; }
  .pk-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 10px; background: var(--color-cloud-100); }
  .pk-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .pk-out .v { font-size: 1.125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pk-note { margin-top: 8px; font-size: 0.8125rem; }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-pk]')) {
    const { formats, hbm, cus } = JSON.parse(fig.dataset.pk!) as { formats: { id: string; label: string; perCU: number; bytes: number }[]; hbm: number; cus: number };
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const out = (k: string) => $<HTMLElement>(`[data-o=${k}]`);
    const update = () => {
      const f = formats.find((x) => x.id === $<HTMLSelectElement>('[data-k=f]').value)!;
      const n = cus;
      const mhz = Number($<HTMLInputElement>('[data-k=clk]').value);
      const peak = f.perCU * n * mhz * 1e6;
      out('clk').textContent = `${mhz.toLocaleString('en-US')} MHz`;
      out('peak').textContent = peak >= 1e15 ? `${(peak / 1e15).toFixed(2)} PFLOPS` : `${(peak / 1e12).toFixed(0)} TFLOPS`;
      const mm = (2 * 8192 ** 3) / peak;
      out('mm').textContent = `${(mm * 1000).toFixed(2)} ms`;
      const ridge = peak / (hbm * 1e9);
      out('ridge').textContent = `${Math.round(ridge).toLocaleString('en-US')} FLOPs/B`;
      // Decode at batch 1: each weight (f.bytes) is used for one multiply-add (2 FLOPs).
      out('dec').textContent = `${(2 / f.bytes).toFixed(1)} FLOPs/B`;
      out('note').textContent = `${f.perCU.toLocaleString('en-US')} FLOPs/clock/CU × ${n} CUs × ${mhz} MHz. Decode for one user does 2 FLOPs per weight read (${f.bytes} B per weight in ${f.label}): about ${Math.round(ridge / (2 / f.bytes)).toLocaleString('en-US')}× below what the matrix cores could use, so it waits on memory. At 200 MHz (a typical idle reading) the same GPU is 12× slower; under load it clocks up.`;
    };
    fig.querySelectorAll('select, input').forEach((el) => el.addEventListener('input', update));
    update();
  }
</script>
