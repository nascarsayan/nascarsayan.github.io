---
/**
 * Number-format encoder: type a value, see its bits in every format, the value
 * actually stored and the rounding error. Encoding logic is shared with the
 * build-time examples (_fp.ts).
 */
import { FORMATS, maxOf, minSub, num } from './_fp';
const presets = ['0.3', '0.1', '3.14159', '0.0137', '448', '500', '70000', '0.00001', '-2.5'];
---

<figure class="fpe" data-fpe>
  <figcaption class="fpe-title">Number-format encoder</figcaption>
  <div class="fpe-in">
    <label>Value <input data-k="x" type="text" inputmode="decimal" value="0.3" size="14" aria-label="Value to encode" /></label>
    <span class="fpe-presets">{presets.map((p) => <button type="button" data-p={p}>{p}</button>)}</span>
  </div>
  <div class="fpe-scroll">
    <table>
      <thead><tr><th>Format</th><th>Bits: <span class="s">sign</span> <span class="e">exponent</span> <span class="m">mantissa</span></th><th>Stored value</th><th>Error</th><th>Range (largest, smallest step near 0)</th></tr></thead>
      <tbody>
        {FORMATS.map((f) => (
          <tr data-f={f.id}>
            <th scope="row">{f.name}<span class="fpe-sub">E{f.e}M{f.m}</span></th>
            <td class="fpe-bits" data-o="bits"></td>
            <td data-o="val"></td>
            <td data-o="err"></td>
            <td class="fpe-range">±{num(maxOf(f), 5)}{f.special === 'ieee' ? ', then ∞' : ' (saturates)'} · {num(minSub(f), 3)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="fpe-note">Round to nearest, ties to even. FP32, BF16, FP16 and E5M2 overflow to ∞; E4M3, FP6 and FP4 have no ∞ and saturate at their largest value, as quantizers do. Values below half the smallest step become 0 (“flushed”).</p>
</figure>

<style>
  .fpe { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; }
  .fpe-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .fpe-in { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: 0.875rem; }
  .fpe-in input { padding: 4px 8px; border: 1px solid var(--color-gray-300); border-radius: 0; font-family: var(--font-family-mono); background: var(--color-background); color: var(--color-text); }
  .fpe-presets { display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .fpe-presets button { padding: 2px 9px; border-radius: 999px; background: var(--color-cloud-100); font-family: var(--font-family-mono); font-size: 0.8125rem; color: var(--color-gray-800); }
  .fpe-presets button:hover { color: var(--color-primary); }
  .fpe-scroll { overflow-x: auto; margin-top: 12px; }
  .fpe table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
  .fpe th, .fpe td { padding: 5px 8px; border-bottom: 1px solid var(--color-gray-100); text-align: left; white-space: nowrap; }
  .fpe thead th { font-size: 0.75rem; color: var(--color-muted); }
  .fpe tbody th { font-weight: 600; }
  .fpe-sub { display: block; font-size: 0.6875rem; font-weight: 400; color: var(--color-muted); }
  .fpe-bits { font-family: var(--font-family-mono); letter-spacing: 0.5px; }
  .fpe .s, .fpe-bits :global(.s) { color: #e5484d; }
  .fpe .e, .fpe-bits :global(.e) { color: #2563eb; }
  .fpe .m, .fpe-bits :global(.m) { color: #16a34a; }
  .fpe-bits :global(.e), .fpe-bits :global(.m), .fpe-bits :global(.s) { padding: 1px 2px; border-radius: 0; background: var(--color-cloud-100); }
  .fpe td :global(.k) { margin-left: 6px; padding: 0 6px; border-radius: 999px; font-size: 0.6875rem; background: var(--color-cloud-100); color: var(--color-gray-700); }
  .fpe td :global(.bad) { background: color-mix(in srgb, #e5484d 18%, transparent); color: #b42318; }
  .fpe-range { color: var(--color-muted); }
  .fpe-note { margin-top: 8px; font-size: 0.75rem; color: var(--color-muted); }
</style>

<script>
  import { FORMATS, encode, bin, num } from './_fp';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-fpe]')) {
    const input = fig.querySelector<HTMLInputElement>('[data-k=x]')!;
    const label: Record<string, string> = { subnormal: 'subnormal', saturated: 'saturated', inf: 'overflow → ∞', flushed: 'flushed to 0', nan: 'NaN' };
    const update = () => {
      const x = Number(input.value.trim().replace('−', '-'));
      for (const f of FORMATS) {
        const row = fig.querySelector<HTMLElement>(`[data-f=${f.id}]`)!;
        const o = (k: string) => row.querySelector<HTMLElement>(`[data-o=${k}]`)!;
        if (!input.value.trim() || Number.isNaN(x)) { o('bits').textContent = '—'; o('val').textContent = ''; o('err').textContent = ''; continue; }
        const r = encode(x, f);
        o('bits').innerHTML = '';
        for (const [cls, txt] of [['s', String(r.sign)], ['e', bin(r.exp, f.e)], ['m', bin(r.man, f.m)]]) {
          const s = document.createElement('span'); s.className = cls; s.textContent = txt; o('bits').append(s, ' ');
        }
        o('val').textContent = num(r.value, 9);
        if (label[r.kind]) { const k = document.createElement('span'); k.className = `k${r.kind === 'subnormal' ? '' : ' bad'}`; k.textContent = label[r.kind]; o('val').append(k); }
        const abs = Math.abs(r.value - x);
        o('err').textContent = !Number.isFinite(abs) ? '∞' : x === 0 ? '0' : `${num((abs / Math.abs(x)) * 100, 3)} %`;
      }
    };
    input.addEventListener('input', update);
    fig.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) => b.addEventListener('click', () => { input.value = b.dataset.p!; update(); }));
    update();
  }
</script>
