---
/**
 * What a DRA driver outage of N seconds does on one GPU node. The 30 s constant is
 * kubelet 1.35's defaultWipingDelay (pkg/kubelet/cm/dra/manager.go). Node and
 * cluster GPU counts come from the sample snapshot.
 */
import { totalGpus, gpuNodes, deviceNames, usedOn, node } from '../k8s-gpu-allocation/_sample';
const cfg = { wipe: 30, perNode: deviceNames.length, total: totalGpus, nodes: gpuNodes.length, running: usedOn(node).length, node };
---

<figure class="rc" data-rc={JSON.stringify(cfg)}>
  <figcaption class="rc-title">DRA driver outage on {node}</figcaption>
  <label class="rc-in">Driver down for <input data-k="down" type="range" min="0" max="36" step="1" value="2" /> <output data-o="down"></output></label>
  <div class="rc-bar" aria-hidden="true"><span class="ok" data-o="barok"></span><span class="bad" data-o="barbad"></span><i data-o="mark"></i></div>
  <p class="rc-axis"><span>0 s: old Pod stops</span><span data-o="axis"></span></p>
  <div class="rc-out">
    <div><span class="k">ResourceSlice wiped?</span><span class="v" data-o="wiped"></span></div>
    <div><span class="k">GPUs hidden from the scheduler</span><span class="v" data-o="hidden"></span></div>
    <div><span class="k">New GPU Pods here wait in ContainerCreating</span><span class="v" data-o="wait"></span></div>
    <div><span class="k">Running GPU Pods affected</span><span class="v" data-o="run"></span></div>
  </div>
  <p class="rc-note" data-o="note"></p>
</figure>

<style>
  .rc { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 14px; }
  .rc-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .rc-in { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.875rem; }
  .rc-in input { accent-color: var(--color-primary); width: 260px; }
  .rc-in output { min-width: 60px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .rc-bar { position: relative; display: flex; height: 18px; margin-top: 14px; border-radius: 999px; overflow: hidden; background: var(--color-gray-100); }
  .rc-bar .ok { background: #f59e0b; }
  .rc-bar .bad { background: #dc2626; }
  .rc-bar i { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--color-text); }
  .rc-axis { display: flex; justify-content: space-between; margin-top: 4px; font-size: 0.75rem; color: var(--color-muted); }
  .rc-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px 16px; margin-top: 12px; }
  .rc-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 10px; background: var(--color-cloud-100); }
  .rc-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .rc-out .v { font-size: 1.0625rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .rc-note { margin-top: 8px; font-size: 0.8125rem; color: var(--color-muted); }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-rc]')) {
    const c = JSON.parse(fig.dataset.rc!);
    const $ = (k: string) => fig.querySelector<HTMLElement>(`[data-o=${k}]`)!;
    const input = fig.querySelector<HTMLInputElement>('[data-k=down]')!;
    const update = () => {
      const d = Number(input.value) * 5; // 0 … 180 s
      const span = Math.max(d, 60);
      const over = Math.max(0, d - c.wipe);
      $('down').textContent = `${d} s`;
      $('barok').style.width = `${(Math.min(d, c.wipe) / span) * 100}%`;
      $('barbad').style.width = `${(over / span) * 100}%`;
      $('mark').style.left = `${(c.wipe / span) * 100}%`;
      $('axis').textContent = `${span} s`;
      $('wiped').textContent = d > c.wipe ? `yes, at ${c.wipe} s` : 'no (timer cancelled)';
      $("hidden").textContent = over ? `${c.perNode} of ${c.total} for ~${over} s (${c.perNode - c.running} were free)` : "0";
      $('wait').textContent = d ? `≥ ${d} s` : '0 s';
      $('run').textContent = `0 of ${c.running}`;
      $('note').textContent = d > c.wipe
        ? `After ${c.wipe} s the kubelet deletes the node's slices: the scheduler sees ${c.total - c.perNode} GPUs on ${c.nodes - 1} nodes until the new driver republishes. Pods ending on this node stay Terminating until unprepare succeeds.`
        : `The new driver registers inside the ${c.wipe} s window: nothing changes in the API. Only Pods starting or ending on this node during the gap wait.`;
    };
    input.addEventListener('input', update);
    update();
  }
</script>
