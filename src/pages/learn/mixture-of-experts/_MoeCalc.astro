---
/**
 * Batch size → experts touched, expert bytes read per step and arithmetic
 * intensity for gpt-oss-120b, under the page's random-routing model.
 * Shapes from the config; MI355X peak and bandwidth are spec-sheet, approximate.
 */
---

<figure class="moc">
  <figcaption class="moc-title">MoE batch calculator (gpt-oss-120b, random routing)</figcaption>
  <div class="moc-in">
    <label>Tokens in the step <input data-k="b" type="range" min="0" max="14" step="1" value="5" /> <output data-o="b"></output></label>
  </div>
  <div class="moc-out">
    <div><span class="k">Experts touched per layer</span><span class="v" data-o="touched"></span></div>
    <div><span class="k">Tokens per touched expert</span><span class="v" data-o="per"></span></div>
    <div><span class="k">Expert bytes read per step</span><span class="v" data-o="bytes"></span></div>
    <div><span class="k">Expert bytes per token</span><span class="v" data-o="pertok"></span></div>
    <div><span class="k">Arithmetic intensity</span><span class="v" data-o="ai"></span></div>
    <div><span class="k">Ideal step time on one MI355X</span><span class="v" data-o="time"></span></div>
  </div>
  <div class="moc-bar" aria-hidden="true"><span data-o="bar"></span></div>
  <p class="moc-note" data-o="note"></p>
  <p class="moc-src">Experts touched = 128 × (1 − (1 − 4/128)<sup>B</sup>). One expert per layer = 3 × 2,880 × 2,880 weights at 4.25 bits = 13.2 MB; 36 layers. Intensity = 2 FLOPs per weight per token ÷ 0.53 bytes per weight × tokens per expert. MI355X: ~5 PFLOP/s dense FP8, ~8 TB/s (spec sheet, approximate). Bar: share of the way to the ridge point (~625 FLOP/byte).</p>
</figure>

<style>
  .moc { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; }
  .moc-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .moc-in label { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.875rem; }
  .moc-in input { width: min(360px, 60vw); accent-color: var(--color-primary); }
  .moc-in output { font-weight: 600; font-variant-numeric: tabular-nums; }
  .moc-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px 16px; margin-top: 14px; }
  .moc-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 0; background: var(--color-cloud-100); }
  .moc-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .moc-out .v { font-size: 1.125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .moc-bar { position: relative; height: 14px; margin-top: 14px; border-radius: 999px; background: var(--color-gray-100); overflow: hidden; }
  .moc-bar span { display: block; height: 100%; background: var(--color-primary); }
  .moc-note { margin-top: 8px; font-size: 0.875rem; }
  .moc-src { margin-top: 4px; font-size: 0.75rem; color: var(--color-muted); }
</style>

<script>
  const BS = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 5300, 8192];
  const EXPERT = (3 * 2880 * 2880 * 4.25) / 8, LAYERS = 36, PEAK = 5e15, BW = 8e12, RIDGE = PEAK / BW;
  for (const fig of document.querySelectorAll<HTMLElement>('.moc')) {
    const o = (k: string) => fig.querySelector<HTMLElement>(`[data-o=${k}]`)!;
    const inp = fig.querySelector<HTMLInputElement>('[data-k=b]')!;
    const update = () => {
      const b = BS[Number(inp.value)];
      const touched = 128 * (1 - (1 - 4 / 128) ** b);
      const per = (b * 4) / touched;
      const bytes = touched * LAYERS * EXPERT;
      const ai = (2 / (4.25 / 8)) * per;
      const flops = b * 4 * LAYERS * 3 * 2880 * 2880 * 2;
      const t = Math.max(bytes / BW, flops / PEAK);
      o('b').textContent = b.toLocaleString('en-US');
      o('touched').textContent = `${touched.toFixed(touched < 10 ? 1 : 0)} of 128`;
      o('per').textContent = per.toFixed(per < 10 ? 1 : 0);
      o('bytes').textContent = `${(bytes / 1e9).toFixed(1)} GB`;
      o('pertok').textContent = bytes / b >= 1e9 ? `${(bytes / b / 1e9).toFixed(2)} GB` : `${(bytes / b / 1e6).toFixed(1)} MB`;
      o('ai').textContent = `${ai.toFixed(0)} FLOP/B`;
      o('time').textContent = `${(t * 1000).toFixed(2)} ms`;
      o('bar').style.width = `${Math.min(100, (ai / RIDGE) * 100)}%`;
      o('note').textContent = ai >= RIDGE
        ? `Compute-bound: each expert sees enough tokens that the matrix units, not HBM, set the pace (experts only; attention and overheads not counted).`
        : `Memory-bound: ${((ai / RIDGE) * 100).toFixed(ai / RIDGE < 0.1 ? 1 : 0)}% of the way to the ridge. The step waits for expert weights to arrive from HBM.`;
    };
    inp.addEventListener('input', update);
    update();
  }
</script>
