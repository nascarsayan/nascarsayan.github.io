---
/**
 * A compact code block for use inside <Walkthrough>, <Variant> and other boxes:
 * the page's normal code blocks bleed past the text column, which breaks out
 * of a bordered box. Code comes from a TS string (real cluster output).
 *   <Yaml code={c.claimStatusYaml} title="kubectl get resourceclaim … -o yaml" />
 */
import { Code } from 'astro:components';
interface Props { code: string; lang?: string; title?: string }
const { code, lang = 'yaml', title } = Astro.props;
---

<figure class="yb">
  {title && <figcaption>{title}</figcaption>}
  <Code code={code} lang={lang as any} themes={{ light: 'github-light-default', dark: 'github-dark-default' }} />
</figure>

<style>
  .yb { margin: 10px 0 12px; }
  .yb figcaption { margin-bottom: 4px; font-family: var(--font-family-mono); font-size: 0.75rem; color: var(--color-muted); }
  .yb :global(pre.astro-code) { margin: 0; padding: 12px 16px; border-radius: 0; background-color: var(--code-bg) !important; box-shadow: 0 0 0 1px var(--code-border); font-size: 0.8125rem; line-height: 1.55; }
</style>
