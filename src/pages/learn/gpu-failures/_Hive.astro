---
/**
 * The 8 GPUs of one MI355X node (one hive) and what a failure does to each:
 * ok | hit (the GPU with the fault) | down (lost with it) | slow | blind (looks fine, is not).
 */
type S = 'ok' | 'hit' | 'down' | 'slow' | 'blind';
interface Props { tiles: S[]; who?: string }
const { tiles, who } = Astro.props;
const word: Record<S, string> = { ok: 'serving', hit: 'fault here', down: 'processes killed', slow: 'slowed down', blind: 'looks healthy' };
---

<figure class="hv">
  <div class="hv-board">
    <span class="hv-name">one GPU node · 8× MI355X · one XGMI hive</span>
    <div class="hv-grid">
      {tiles.map((s, i) => (
        <div class:list={['hv-gpu', `s-${s}`]}><b>GPU {i}</b><span>{word[s]}</span></div>
      ))}
    </div>
  </div>
  {who && <figcaption>{who}</figcaption>}
</figure>

<style>
  .hv { margin: 12px 0; }
  .hv-board { padding: 10px 12px 12px; border: 2px dashed var(--color-gray-300); border-radius: 0; }
  .hv-name { display: block; margin-bottom: 8px; font-size: 0.75rem; color: var(--color-muted); }
  .hv-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .hv-gpu { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 0; border: 1px solid var(--color-gray-100); background: var(--color-success-100); font-size: 0.8125rem; }
  .hv-gpu b { font-size: 0.875rem; }
  .hv-gpu.s-hit { background: var(--color-error); color: white; border-color: var(--color-error); }
  .hv-gpu.s-down { background: var(--color-error-100); border-color: var(--color-error); }
  .hv-gpu.s-slow { background: var(--color-warning-100); border-color: var(--color-alert); }
  .hv-gpu.s-blind { background: var(--color-warning-100); border: 1px dashed var(--color-alert); }
  .hv figcaption { margin-top: 6px; font-size: 0.875rem; }
</style>
