---
/**
 * Interactive MI355X node map (illustrative example node): two CPU sockets, four
 * slices each. Pick a GPU and a NIC; the map lights both slices and says how far
 * apart they are. Data from ./_node.ts.
 */
import { slices, socket, distance } from './_node';
const bySocket = [0, 1].map((k) => slices.filter((s) => socket(s) === k).sort((a, b) => a.gpu - b.gpu));
const pairs = Object.fromEntries(slices.flatMap((g) => slices.map((n) => [`${g.gpu}-${n.gpu}`, distance(g, n)])));
---

<figure class="nm" data-nm={JSON.stringify({ slices, pairs })}>
  <figcaption class="nm-title">Example MI355X server map (gpu-node-1)</figcaption>
  <div class="nm-in">
    <label>GPU <select data-k="gpu">{slices.map((s) => <option value={s.gpu} selected={s.gpu === 5}>GPU {s.gpu} ({s.bdf})</option>)}</select></label>
    <label>paired with NIC <select data-k="nic">{slices.map((s) => <option value={s.gpu} selected={s.gpu === 5}>{s.mlx} ({s.netdev})</option>)}</select></label>
    <button type="button" data-k="best">Pick the closest NIC</button>
  </div>
  <div class="nm-map">
    {bySocket.map((list, k) => (
      <div class="nm-sock">
        <p class="nm-sock-h">CPU {k} · NUMA node {k} · PCI buses {k === 0 ? '00–7f' : '80–ff'}</p>
        <div class="nm-slices">
          {list.map((s) => (
            <div class="nm-slice" data-slice={s.gpu}>
              <p class="nm-numa">NUMA {s.numa}<span>cores {s.cores}</span></p>
              <p class="nm-root">root <code>{s.root}</code></p>
              <p class="nm-sw">PCIe Gen5 switch</p>
              <div class="nm-devs">
                <p class="nm-gpu" data-gpu={s.gpu}>GPU {s.gpu}<span>{s.bdf}</span></p>
                <p class="nm-nic" data-nic={s.gpu}>{s.mlx}<span>{s.netdev}</span></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="nm-out" data-o="out" aria-live="polite"></p>
  <p class="nm-src">Socket-to-socket traffic crosses the CPUs' own interconnect. GPU-to-GPU traffic does not use this map at all: all 8 GPUs are one XGMI full mesh.</p>
</figure>

<style>
  .nm { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 14px; }
  .nm-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .nm-in { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; font-size: 0.875rem; }
  .nm-in label { display: flex; align-items: center; gap: 6px; }
  .nm-in button { padding: 4px 12px; border-radius: 999px; background: var(--color-cloud-100); font-size: 0.8125rem; }
  .nm-in button:hover { color: var(--color-primary); }
  .nm-map { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 14px; }
  .nm-sock { padding: 8px; border-radius: 12px; background: var(--color-cloud-100); }
  .nm-sock-h { margin: 0 0 6px; font-size: 0.8125rem; font-weight: 700; }
  .nm-slices { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 6px; }
  .nm-slice { padding: 6px; border: 2px solid transparent; border-radius: 10px; background: var(--color-background); font-size: 0.75rem; line-height: 1.3; opacity: 0.55; transition: opacity 150ms, border-color 150ms; }
  .nm-slice.is-g, .nm-slice.is-n { opacity: 1; border-color: var(--color-primary); }
  .nm-slice p { margin: 0 0 4px; }
  .nm-slice span { display: block; font-weight: 400; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .nm-numa { font-weight: 700; }
  .nm-root code { font-size: 0.6875rem; }
  .nm-sw { padding: 2px 4px; border-radius: 6px; background: var(--color-gray-100); text-align: center; }
  .nm-devs { display: grid; gap: 4px; }
  .nm-gpu, .nm-nic { padding: 3px 5px; border-radius: 6px; font-weight: 700; }
  .nm-gpu { background: color-mix(in srgb, #3b82f6 18%, transparent); }
  .nm-nic { background: color-mix(in srgb, #14b8a6 18%, transparent); }
  .nm-gpu.on, .nm-nic.on { outline: 2px solid var(--color-primary); }
  .nm-out { margin-top: 10px; font-size: 0.9375rem; }
  .nm-out :global(b.good) { color: #1a7f37; }
  .nm-out :global(b.warn) { color: #b45309; }
  .nm-out :global(b.risk) { color: #c4320a; }
  .nm-src { margin-top: 4px; font-size: 0.75rem; color: var(--color-muted); }
</style>

<script>
  import type { Slice } from './_node';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-nm]')) {
    const { slices, pairs } = JSON.parse(fig.dataset.nm!) as { slices: Slice[]; pairs: Record<string, string> };
    const gpu = fig.querySelector<HTMLSelectElement>('[data-k=gpu]')!;
    const nic = fig.querySelector<HTMLSelectElement>('[data-k=nic]')!;
    const out = fig.querySelector<HTMLElement>('[data-o=out]')!;
    const update = () => {
      const g = slices[Number(gpu.value)], n = slices[Number(nic.value)];
      fig.querySelectorAll<HTMLElement>('[data-slice]').forEach((el) => {
        el.classList.toggle('is-g', el.dataset.slice === String(g.gpu));
        el.classList.toggle('is-n', el.dataset.slice === String(n.gpu));
      });
      fig.querySelectorAll<HTMLElement>('[data-gpu]').forEach((el) => el.classList.toggle('on', el.dataset.gpu === String(g.gpu)));
      fig.querySelectorAll<HTMLElement>('[data-nic]').forEach((el) => el.classList.toggle('on', el.dataset.nic === String(n.gpu)));
      const d = pairs[`${g.gpu}-${n.gpu}`];
      const tone = d === 'same PCIe switch' ? 'good' : d === 'other CPU socket' ? 'risk' : 'warn';
      const why = tone === 'good'
        ? `bytes go GPU → switch → NIC and never reach the CPU. Best case for GPUDirect RDMA. Feed it from cores ${g.cores} (NUMA ${g.numa}).`
        : tone === 'warn'
          ? `bytes climb from GPU ${g.gpu}'s switch to root ${g.root}, cross the CPU to root ${n.root}, and come down to the NIC. Slower, and through the CPU's I/O fabric.`
          : `bytes leave through root ${g.root}, cross the socket-to-socket link, and enter CPU ${parseInt(n.bdf.split(':')[1], 16) >= 0x80 ? 1 : 0} at ${n.root}. The worst path on this node.`;
      out.innerHTML = `GPU ${g.gpu} (<code>${g.bdf}</code>, ResourceSlice device <code>${g.dra}</code>) ↔ ${n.mlx} (<code>${n.netdev}</code>): <b class="${tone}">${d}</b>: ${why}`;
    };
    fig.querySelector('[data-k=best]')!.addEventListener('click', () => { nic.value = gpu.value; update(); });
    fig.querySelectorAll<HTMLElement>('[data-slice]').forEach((el) => el.addEventListener('click', () => { gpu.value = el.dataset.slice!; nic.value = el.dataset.slice!; update(); }));
    [gpu, nic].forEach((el) => el.addEventListener('input', update));
    update();
  }
</script>
