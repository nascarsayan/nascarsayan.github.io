---
/**
 * Prefix-cache hit calculator: hits are whole blocks of a matching prefix, and
 * the last prompt token is always computed (vLLM V1 kv_cache_manager).
 */
---

<figure class="pxc" data-pxc>
  <figcaption class="pxc-title">Prefix cache hit calculator (gpt-oss-120b)</figcaption>
  <div class="pxc-in">
    <label>Prompt length <input data-k="n" type="range" min="16" max="8192" step="1" value="2760" /> <output data-o="n"></output></label>
    <label>Tokens identical to a cached prompt, from token 0 <input data-k="s" type="range" min="0" max="100" step="1" value="12" /> <output data-o="s"></output></label>
    <label>Block size <select data-k="bs"><option value="16">16 (vLLM examples)</option><option value="32">32</option><option value="64">64</option><option value="128" selected>128</option></select></label>
  </div>
  <div class="pxc-bar" aria-hidden="true"><span class="hit" data-o="bhit"></span><span class="lost" data-o="blost"></span><span class="new" data-o="bnew"></span></div>
  <div class="pxc-out">
    <div><span class="k">cached_tokens (whole blocks)</span><span class="v" data-o="hit"></span></div>
    <div><span class="k">Shared, but recomputed (partial block)</span><span class="v" data-o="lost"></span></div>
    <div><span class="k">uncached_tokens (computed)</span><span class="v" data-o="new"></span></div>
    <div><span class="k">Linear FLOPs saved (~9 GFLOP/token)</span><span class="v" data-o="fl"></span></div>
    <div><span class="k">KV not rebuilt (36 KiB/token)</span><span class="v" data-o="kv"></span></div>
  </div>
  <p class="pxc-note">Green: reused blocks. Amber: matching tokens lost to block rounding (or the always-computed last token). Grey: new tokens. Only a prefix counts: one different token early in the prompt ends the match there, however much text matches later.</p>
</figure>

<style>
  .pxc { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; }
  .pxc-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .pxc-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px 20px; font-size: 0.875rem; }
  .pxc-in label { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .pxc-in select, .pxc-in input { accent-color: var(--color-primary); }
  .pxc-in output { min-width: 60px; font-variant-numeric: tabular-nums; font-weight: 600; }
  .pxc-bar { display: flex; height: 18px; margin-top: 14px; border-radius: 999px; overflow: hidden; background: #94a3b8; }
  .pxc-bar .hit { background: #22c55e; }
  .pxc-bar .lost { background: #eab308; }
  .pxc-bar .new { background: #94a3b8; }
  .pxc-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px 16px; margin-top: 14px; }
  .pxc-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 0; background: var(--color-cloud-100); }
  .pxc-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .pxc-out .v { font-size: 1.125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pxc-note { margin-top: 8px; font-size: 0.8125rem; color: var(--color-muted); }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-pxc]')) {
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const out = (k: string) => $<HTMLElement>(`[data-o=${k}]`);
    const fmt = (v: number) => v.toLocaleString('en-US');
    const update = () => {
      const n = Number($<HTMLInputElement>('[data-k=n]').value);
      const s = Math.round((n * Number($<HTMLInputElement>('[data-k=s]').value)) / 100);
      const bs = Number($<HTMLSelectElement>('[data-k=bs]').value);
      const hit = Math.min(Math.floor(s / bs), Math.floor((n - 1) / bs)) * bs;
      const lost = s - hit, nw = n - hit;
      out('n').textContent = `${fmt(n)} tokens`;
      out('s').textContent = `${fmt(s)} tokens`;
      out('hit').textContent = `${fmt(hit)} (${hit / bs} blocks)`;
      out('lost').textContent = fmt(lost);
      out('new').textContent = fmt(nw);
      out('fl').textContent = `${((hit * 9e9) / 1e12).toFixed(1)} TFLOP`;
      out('kv').textContent = `${((hit * 36 * 1024) / 2 ** 20).toFixed(1)} MiB`;
      out('bhit').style.width = `${(hit / n) * 100}%`;
      out('blost').style.width = `${(lost / n) * 100}%`;
      out('bnew').style.width = `${((n - s) / n) * 100}%`;
    };
    fig.querySelectorAll('select, input').forEach((el) => el.addEventListener('input', update));
    update();
  }
</script>
