---
/**
 * Pick one of the 8 GPUs on gpu-node-1: see the CDI name, file and device
 * nodes a claim for it gets. All values come from _cdi.ts (derived from the example
 * ResourceSlice device names and checked against the example CDI file).
 */
import { decoder, nodeName } from './_cdi';
---

<figure class="cdd" data-cdd={JSON.stringify(decoder)}>
  <figcaption class="cdd-title">CDI decoder: one GPU on {nodeName}</figcaption>
  <label class="cdd-in">ResourceSlice device
    <select data-k="dev">{decoder.map((d) => <option value={d.name} selected={d.name === 'gpu-5-132'}>{d.name}</option>)}</select>
  </label>
  <div class="cdd-out">
    <div><span class="k">Name parts</span><span class="v" data-o="parts"></span></div>
    <div><span class="k">PCI address · NUMA node</span><span class="v" data-o="pci"></span></div>
    <div><span class="k">Held by</span><span class="v" data-o="held"></span></div>
  </div>
  <pre class="cdd-pre"><code data-o="nodes"></code></pre>
  <p class="cdd-note">Device name <code>gpu-&lt;card&gt;-&lt;render&gt;</code> = the two DRM minor numbers. Every claim also gets <code>/dev/kfd</code> (238:0) and the <code>common</code> env entry. The per-claim CDI name is <code>k8s.gpu.amd.com/gpu=&lt;claim-uid&gt;-&lt;device&gt;</code>.</p>
</figure>

<style>
  .cdd { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; }
  .cdd-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .cdd-in { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.875rem; }
  .cdd-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px 16px; margin-top: 12px; }
  .cdd-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 0; background: var(--color-cloud-100); }
  .cdd-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .cdd-out .v { font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .cdd-pre { margin-top: 12px; padding: 10px 14px; border-radius: 0; background: var(--code-bg); color: var(--code-fg); box-shadow: 0 0 0 1px var(--code-border); font-size: 0.875rem; overflow-x: auto; }
  .cdd-note { margin-top: 8px; font-size: 0.8125rem; color: var(--color-muted); }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-cdd]')) {
    const data = JSON.parse(fig.dataset.cdd!) as { name: string; pci: string; numa: number; nodes: string[]; heldBy: string | null }[];
    const sel = fig.querySelector<HTMLSelectElement>('[data-k=dev]')!;
    const out = (k: string) => fig.querySelector<HTMLElement>(`[data-o=${k}]`)!;
    const update = () => {
      const d = data.find((x) => x.name === sel.value)!;
      const [, card, render] = d.name.split('-');
      out('parts').textContent = `card${card} · renderD${render}`;
      out('pci').textContent = `${d.pci} · ${d.numa}`;
      out('held').textContent = d.heldBy ?? 'free';
      out('nodes').textContent = d.nodes.join('\n');
    };
    sel.addEventListener('input', update);
    update();
  }
</script>
