---
/**
 * Roofline explorer for this page: pick a GPU, a number format and a kernel
 * shape; see arithmetic intensity against the ridge point, live.
 * Peaks are dense (no sparsity) spec-sheet values, approximate:
 * MI355X from AMD's product page; H100 SXM = NVIDIA's sparse figure ÷ 2;
 * B200 = DGX B200 figure ÷ 8 GPUs (÷ 2 more for FP8, which NVIDIA lists sparse).
 */
const gpus = {
  'MI355X': { bw: 8.0, peaks: { bf16: 2500, fp8: 5000, fp4: 10100 }, src: 'AMD MI355X spec page: 2.5 / 5 / 10.1 PFLOP/s dense, 8 TB/s' },
  'H100 SXM': { bw: 3.35, peaks: { bf16: 989.5, fp8: 1979 }, src: 'NVIDIA H100 page: 1,979 / 3,958 TFLOP/s with sparsity, halved; 3.35 TB/s' },
  'B200': { bw: 8.0, peaks: { fp8: 4500, fp4: 9000 }, src: 'DGX B200 page ÷ 8: FP8 72 PFLOP/s (sparse) ÷ 2, FP4 72 PFLOP/s dense, 64 TB/s; derived, not quoted per GPU' },
};
const presets = [
  { label: 'Decode, 1 sequence (Q/K/V proj.)', M: 1, N: 5120, K: 2880 },
  { label: 'Decode, batch 64 (Q/K/V proj.)', M: 64, N: 5120, K: 2880 },
  { label: 'Prefill, 4,000 tokens (Q/K/V proj.)', M: 4000, N: 5120, K: 2880 },
  { label: 'Square GEMM 8,192³', M: 8192, N: 8192, K: 8192 },
  { label: 'Element-wise add (residual)', M: 0, N: 0, K: 0 },
];
---

<figure class="rl" data-rl={JSON.stringify({ gpus, presets })}>
  <figcaption class="rl-title">Roofline explorer</figcaption>
  <div class="rl-in">
    <label>GPU <select data-k="gpu">{Object.keys(gpus).map((g) => <option value={g}>{g}</option>)}</select></label>
    <label>Weights format <select data-k="fmt"></select></label>
    <label>Kernel <select data-k="preset">{presets.map((p, i) => <option value={i}>{p.label}</option>)}</select></label>
    <label>M (tokens) <input data-k="M" type="number" min="1" max="1000000" /></label>
    <label>N (outputs) <input data-k="N" type="number" min="1" max="1000000" /></label>
    <label>K (inputs) <input data-k="K" type="number" min="1" max="1000000" /></label>
  </div>
  <svg class="rl-plot" viewBox="0 0 640 300" role="img" aria-label="Roofline plot">
    <g data-o="grid"></g>
    <polyline data-o="roof" fill="none" stroke="var(--color-primary)" stroke-width="3" />
    <line data-o="ridge" stroke="var(--color-gray-500)" stroke-dasharray="4 4" />
    <text data-o="ridgeT" class="rl-lbl" text-anchor="middle"></text>
    <circle data-o="pt" r="7" fill="#e5484d" stroke="white" stroke-width="2" />
    <text data-o="ptT" class="rl-lbl rl-pt"></text>
    <text x="330" y="296" class="rl-ax" text-anchor="middle">arithmetic intensity, FLOP per byte from HBM (log)</text>
    <text x="12" y="150" class="rl-ax" text-anchor="middle" transform="rotate(-90 12 150)">TFLOP/s (log)</text>
  </svg>
  <div class="rl-out">
    <div><span class="k">FLOPs</span><span class="v" data-o="flops"></span></div>
    <div><span class="k">Bytes (minimum)</span><span class="v" data-o="bytes"></span></div>
    <div><span class="k">Intensity</span><span class="v" data-o="I"></span></div>
    <div><span class="k">Ridge point</span><span class="v" data-o="R"></span></div>
    <div><span class="k">Best possible</span><span class="v" data-o="att"></span></div>
    <div><span class="k">Lower bound on time</span><span class="v" data-o="time"></span></div>
  </div>
  <p class="rl-note" data-o="verdict"></p>
  <p class="rl-src" data-o="src"></p>
</figure>

<style>
  .rl { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; }
  .rl-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .rl-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px 18px; font-size: 0.875rem; }
  .rl-in label { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .rl-in input { width: 110px; font-variant-numeric: tabular-nums; }
  .rl-in select, .rl-in input { accent-color: var(--color-primary); }
  .rl-plot { display: block; width: 100%; max-width: 760px; margin: 14px 0 4px; }
  .rl-plot :global(.rl-g) { stroke: var(--color-gray-100); }
  .rl-plot :global(.rl-tick), .rl-ax { font-size: 11px; fill: var(--color-muted); }
  .rl-lbl { font-size: 12px; fill: var(--color-gray-700); }
  .rl-pt { font-weight: 700; fill: #e5484d; }
  .rl-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px 14px; margin-top: 8px; }
  .rl-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 0; background: var(--color-cloud-100); }
  .rl-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .rl-out .v { font-size: 1.0625rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .rl-note { margin-top: 8px; font-size: 0.875rem; }
  .rl-src { margin-top: 2px; font-size: 0.75rem; color: var(--color-muted); }
</style>

<script>
  const FMT: Record<string, { label: string; w: number; act: number }> = {
    bf16: { label: 'BF16 (2 B)', w: 2, act: 2 },
    fp8: { label: 'FP8 (1 B)', w: 1, act: 1 },
    fp4: { label: 'MXFP4 (~0.53 B)', w: 0.53125, act: 1 },
  };
  const X0 = 0.1, X1 = 1e4, PX = [50, 625], PY = [270, 12];
  const lx = (v: number) => PX[0] + ((Math.log10(v) - Math.log10(X0)) / (Math.log10(X1) - Math.log10(X0))) * (PX[1] - PX[0]);
  const si = (n: number, u: string) => (n >= 1e12 ? `${(n / 1e12).toFixed(2)} T${u}` : n >= 1e9 ? `${(n / 1e9).toFixed(2)} G${u}` : n >= 1e6 ? `${(n / 1e6).toFixed(2)} M${u}` : n >= 1e3 ? `${(n / 1e3).toFixed(1)} k${u}` : `${n.toFixed(0)} ${u}`);
  const tm = (s: number) => (s >= 1e-3 ? `${(s * 1e3).toFixed(2)} ms` : s >= 1e-6 ? `${(s * 1e6).toFixed(1)} µs` : `${(s * 1e9).toFixed(0)} ns`);
  for (const fig of document.querySelectorAll<HTMLElement>('[data-rl]')) {
    const { gpus, presets } = JSON.parse(fig.dataset.rl!);
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const o = (k: string) => $<SVGElement & HTMLElement>(`[data-o=${k}]`);
    const gpuSel = $<HTMLSelectElement>('[data-k=gpu]'), fmtSel = $<HTMLSelectElement>('[data-k=fmt]'), pre = $<HTMLSelectElement>('[data-k=preset]');
    const dim = (k: string) => $<HTMLInputElement>(`[data-k=${k}]`);
    const fillFmt = () => {
      const keep = fmtSel.value;
      const keys = Object.keys(gpus[gpuSel.value].peaks);
      fmtSel.innerHTML = keys.map((k) => `<option value="${k}">${FMT[k].label}</option>`).join('');
      fmtSel.value = keys.includes(keep) ? keep : keys.includes('fp8') ? 'fp8' : keys[0];
    };
    const setPreset = () => {
      const p = presets[Number(pre.value)];
      const ew = p.M === 0;
      ['M', 'N', 'K'].forEach((k) => { dim(k).value = ew ? '' : String(p[k]); dim(k).disabled = ew; });
    };
    const update = () => {
      const g = gpus[gpuSel.value], f = FMT[fmtSel.value];
      const peak = g.peaks[fmtSel.value] * 1e12, bw = g.bw * 1e12;
      const ew = presets[Number(pre.value)].M === 0;
      let flops: number, bytes: number;
      if (ew) {
        const n = 100e6; // 100 M elements, y = x + r, in the activation format
        flops = n; bytes = 3 * n * f.act;
      } else {
        const [M, N, K] = ['M', 'N', 'K'].map((k) => Math.max(1, Math.min(1e6, Math.round(Number(dim(k).value) || 1))));
        flops = 2 * M * N * K;
        bytes = M * K * f.act + K * N * f.w + M * N * f.act; // read A (activations), B (weights), write C
      }
      const I = flops / bytes, R = peak / bw, att = Math.min(peak, bw * I);
      const Y0 = 0.1, Y1 = 2e4;
      const ly = (v: number) => PY[0] + ((Math.log10(v) - Math.log10(Y0)) / (Math.log10(Y1) - Math.log10(Y0))) * (PY[1] - PY[0]);
      const T = (v: number) => v / 1e12;
      o('grid').innerHTML = [0.1, 1, 10, 100, 1000, 10000].map((x) => `<line class="rl-g" x1="${lx(x)}" x2="${lx(x)}" y1="${PY[1]}" y2="${PY[0]}"/><text class="rl-tick" x="${lx(x)}" y="${PY[0] + 14}" text-anchor="middle">${x}</text>`).join('')
        + [0.1, 1, 10, 100, 1000, 10000].map((y) => `<line class="rl-g" x1="${PX[0]}" x2="${PX[1]}" y1="${ly(y)}" y2="${ly(y)}"/><text class="rl-tick" x="${PX[0] - 6}" y="${ly(y) + 4}" text-anchor="end">${y}</text>`).join('');
      const xs = Math.max(X0, (Y0 * 1e12) / bw);
      o('roof').setAttribute('points', `${lx(xs)},${ly(T(bw * xs))} ${lx(R)},${ly(T(peak))} ${lx(X1)},${ly(T(peak))}`);
      o('ridge').setAttribute('x1', String(lx(R))); o('ridge').setAttribute('x2', String(lx(R)));
      o('ridge').setAttribute('y1', String(ly(T(peak)))); o('ridge').setAttribute('y2', String(PY[0]));
      o('ridgeT').setAttribute('x', String(lx(R))); o('ridgeT').setAttribute('y', String(ly(T(peak)) - 6));
      o('ridgeT').textContent = `ridge ≈ ${R.toFixed(0)} FLOP/B`;
      const ix = Math.min(X1, Math.max(X0, I));
      o('pt').setAttribute('cx', String(lx(ix))); o('pt').setAttribute('cy', String(ly(Math.max(Y0, T(att)))));
      const right = lx(ix) > 470;
      o('ptT').setAttribute('x', String(lx(ix) + (right ? -12 : 12))); o('ptT').setAttribute('y', String(ly(Math.max(Y0, T(att))) + 18));
      o('ptT').setAttribute('text-anchor', right ? 'end' : 'start');
      o('ptT').textContent = `this kernel: ${T(att).toFixed(T(att) < 10 ? 2 : 0)} TFLOP/s`;
      o('flops').textContent = si(flops, 'FLOP');
      o('bytes').textContent = si(bytes, 'B');
      o('I').textContent = `${I < 10 ? I.toFixed(2) : I.toFixed(0)} FLOP/B`;
      o('R').textContent = `${R.toFixed(0)} FLOP/B`;
      o('att').textContent = `${T(att).toFixed(T(att) < 10 ? 2 : 0)} TFLOP/s (${((att / peak) * 100).toFixed(att / peak < 0.1 ? 2 : 0)} % of peak)`;
      o('time').textContent = tm(Math.max(flops / peak, bytes / bw));
      o('verdict').textContent = I < R
        ? `Memory-bound: intensity is ${(R / I).toFixed(R / I < 10 ? 1 : 0)}× below the ridge. The kernel waits on HBM; more FLOP/s would not help.${ew ? '' : ' Raise M (batch more tokens per weight read) to move right.'}`
        : `Compute-bound: intensity is ${(I / R).toFixed(1)}× above the ridge, if the kernel reaches near-minimum traffic (that is what tiling is for).`;
      o('src').textContent = `${g.src}. Bytes assume each matrix crosses HBM exactly once (A and C in ${fmtSel.value === 'bf16' ? 'BF16' : '8-bit'}, weights in ${f.label}). ${ew ? 'Element-wise: 100 M elements, 1 FLOP, 3 accesses each. ' : ''}Spec peaks are approximate.`;
    };
    gpuSel.addEventListener('input', () => { fillFmt(); update(); });
    fmtSel.addEventListener('input', update);
    pre.addEventListener('input', () => { setPreset(); update(); });
    ['M', 'N', 'K'].forEach((k) => dim(k).addEventListener('input', update));
    fillFmt(); setPreset(); update();
  }
</script>
