---
/**
 * HBM traffic of naive vs FlashAttention for one attention layer (prefill).
 * Simple model, stated on the figure: non-causal, no L2 hits.
 * Peaks are MI355X spec-sheet values (approximate), as on the roofline page.
 */
---

<figure class="fac" data-fac>
  <figcaption class="fac-title">HBM traffic: naive attention vs FlashAttention (one layer, prefill)</figcaption>
  <div class="fac-in">
    <label>Prompt length T <input data-k="t" type="range" min="0" max="7" step="1" value="2" /> <output data-o="t"></output></label>
    <label>Head size d <select data-k="d"><option value="64">64 (gpt-oss-120b)</option><option value="128">128 (Llama 3.3 70B)</option></select></label>
    <label>Query heads <select data-k="h"><option value="64">64</option><option value="32">32</option><option value="8">8</option></select></label>
    <label>KV heads <select data-k="kv"><option value="8">8 (GQA, both models)</option><option value="0">one per query head (no GQA)</option></select></label>
    <label>Query block (rows per workgroup) <select data-k="br"><option value="64">64</option><option value="128" selected>128</option><option value="256">256</option></select></label>
  </div>
  <div class="fac-out">
    <div><span class="k">S for one head (FP32)</span><span class="v" data-o="s"></span></div>
    <div><span class="k">Naive: bytes moved</span><span class="v" data-o="nb"></span></div>
    <div><span class="k">Flash: bytes moved</span><span class="v" data-o="fb"></span></div>
    <div><span class="k">Matrix FLOPs (QKᵀ + PV)</span><span class="v" data-o="fl"></span></div>
    <div><span class="k">Naive: FLOP per byte</span><span class="v" data-o="ni"></span></div>
    <div><span class="k">Flash: FLOP per byte</span><span class="v" data-o="fi"></span></div>
  </div>
  <div class="fac-bars" aria-hidden="true">
    <div><span class="lab">Naive</span><span class="bar"><span class="fill n" data-o="nbar"></span></span><span class="t" data-o="nt"></span></div>
    <div><span class="lab">Flash</span><span class="bar"><span class="fill f" data-o="fbar"></span></span><span class="t" data-o="ft"></span></div>
  </div>
  <p class="fac-note" data-o="note"></p>
  <p class="fac-src">Model: naive reads Q, K, V, writes O, and writes then reads S (FP32) and P (BF16); flash reads Q and writes O once, and reads K and V once per query block and KV head (with GQA the query heads of a group share one read). BF16 Q/K/V/O. Non-causal (causal halves both FLOPs and flash K/V reads), no L2 hits. Time = max(bytes ÷ 8 TB/s, FLOPs ÷ 2.5 PFLOP/s), MI355X spec peaks, approximate: a lower bound, not a prediction.</p>
</figure>

<style>
  .fac { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 14px; }
  .fac-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .fac-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px 20px; font-size: 0.875rem; }
  .fac-in label { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .fac-in select, .fac-in input { accent-color: var(--color-primary); }
  .fac-in output { min-width: 60px; font-variant-numeric: tabular-nums; font-weight: 600; }
  .fac-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px 16px; margin-top: 14px; }
  .fac-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 10px; background: var(--color-cloud-100); }
  .fac-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .fac-out .v { font-size: 1.125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .fac-bars { display: grid; gap: 6px; margin-top: 14px; font-size: 0.8125rem; }
  .fac-bars div { display: grid; grid-template-columns: 48px 1fr 150px; align-items: center; gap: 8px; }
  .fac-bars .bar { height: 16px; border-radius: 999px; background: var(--color-gray-100); overflow: hidden; }
  .fac-bars .fill { display: block; height: 100%; }
  .fac-bars .n { background: #e5484d; }
  .fac-bars .f { background: var(--color-primary); }
  .fac-bars .t { font-variant-numeric: tabular-nums; }
  .fac-note { margin-top: 8px; font-size: 0.875rem; }
  .fac-src { margin-top: 2px; font-size: 0.75rem; color: var(--color-muted); }
</style>

<script>
  const TS = [1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072];
  const BW = 8e12, PEAK = 2.5e15;
  const size = (b: number) => (b >= 1e9 ? `${(b / 1e9).toFixed(1)} GB` : b >= 1e6 ? `${(b / 1e6).toFixed(1)} MB` : `${(b / 1e3).toFixed(1)} KB`);
  const num = (x: number) => (x >= 1e12 ? `${(x / 1e12).toFixed(1)} T` : `${(x / 1e9).toFixed(1)} G`);
  const ms = (s: number) => (s >= 1e-3 ? `${(s * 1e3).toFixed(2)} ms` : `${(s * 1e6).toFixed(0)} µs`);
  for (const fig of document.querySelectorAll<HTMLElement>('[data-fac]')) {
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const out = (k: string) => $<HTMLElement>(`[data-o=${k}]`);
    const update = () => {
      const T = TS[Number($<HTMLInputElement>('[data-k=t]').value)];
      const d = Number($<HTMLSelectElement>('[data-k=d]').value);
      const h = Number($<HTMLSelectElement>('[data-k=h]').value);
      const br = Number($<HTMLSelectElement>('[data-k=br]').value);
      const kv = Number($<HTMLSelectElement>('[data-k=kv]').value) || h;
      const td = T * d * 2;
      const naive = h * (2 * td + 2 * T * T * 4 + 2 * T * T * 2) + kv * 2 * td;
      // GQA: one workgroup serves the query heads of one KV head, so K and V are read once per (query block, KV head).
      const flash = h * 2 * td + kv * Math.ceil(T / br) * 2 * td;
      const flops = h * 4 * T * T * d;
      const tn = Math.max(naive / BW, flops / PEAK), tf = Math.max(flash / BW, flops / PEAK);
      out('t').textContent = `${T / 1024}k tokens`;
      out('s').textContent = size(T * T * 4);
      out('nb').textContent = size(naive);
      out('fb').textContent = size(flash);
      out('fl').textContent = `${num(flops)}FLOP`;
      out('ni').textContent = (flops / naive).toFixed(1);
      out('fi').textContent = (flops / flash).toFixed(0);
      const top = Math.max(tn, tf);
      out('nbar').style.width = `${(tn / top) * 100}%`;
      out('fbar').style.width = `${(tf / top) * 100}%`;
      out('nt').textContent = `≥ ${ms(tn)} (${naive / BW > flops / PEAK ? 'memory' : 'compute'})`;
      out('ft').textContent = `≥ ${ms(tf)} (${flash / BW > flops / PEAK ? 'memory' : 'compute'})`;
      out('note').textContent = `Flash moves ${(naive / flash).toFixed(0)}× fewer bytes. Naive sits at ${(flops / naive).toFixed(1)} FLOP/B, far below the ~310 FLOP/B BF16 ridge, so it waits on HBM; flash at ${(flops / flash).toFixed(0)} FLOP/B is ${flops / flash > PEAK / BW ? 'above the ridge: the matrix cores set the speed' : 'still below the ridge: a larger query block would help'}.`;
    };
    fig.querySelectorAll('select, input').forEach((el) => el.addEventListener('input', update));
    update();
  }
</script>
