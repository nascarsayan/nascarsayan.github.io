---
/**
 * One wavefront drawn as 64 lanes: 4 rows of 16, the way a CDNA SIMD issues a
 * wave64 instruction (16 lanes per cycle, 4 cycles). Lit cells = EXEC bit 1.
 * `regs` lists 64-bit masks (EXEC, VCC, saved copies) as hex and as bit strips.
 */
import { hex, count, type Mask } from './_exec';
interface Reg { name: string; mask: Mask; note?: string }
interface Props { active: Mask; values?: string[]; tone?: 'on' | 'then' | 'else' | 'mix'; split?: Mask; regs?: Reg[]; caption?: string }
const { active, values, tone = 'on', split, regs = [], caption } = Astro.props;
const rows = [0, 1, 2, 3];
const cls = (i: number) => {
  if (!active[i]) return 'off';
  if (tone === 'mix' && split) return split[i] ? 'else' : 'then';
  return tone;
};
---

<figure class="ln">
  {regs.length > 0 && (
    <table class="ln-regs">
      <tbody>
        {regs.map((r) => (
          <tr>
            <th scope="row">{r.name}</th>
            <td class="ln-hex">{hex(r.mask)}</td>
            <td class="ln-strip" aria-hidden="true">{[...r.mask].reverse().map((b) => <i class:list={[{ b1: b }]} />)}</td>
            <td class="ln-n">{count(r.mask)} lanes{r.note ? ` · ${r.note}` : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
  <div class="ln-grid" role="img" aria-label={`${count(active)} of 64 lanes active`}>
    {rows.map((r) => (
      <div class="ln-row">
        <span class="ln-cyc">cycle {r + 1}<br /><small>lanes {r * 16}–{r * 16 + 15}</small></span>
        {[...Array(16).keys()].map((c) => {
          const i = r * 16 + c;
          return (
            <span class:list={['ln-cell', cls(i)]} title={`lane ${i}`}>
              <small>{i}</small>
              <b>{values?.[i] ?? ''}</b>
            </span>
          );
        })}
      </div>
    ))}
  </div>
  {caption && <figcaption class="ln-cap" set:html={caption} />}
</figure>

<style>
  .ln { margin: 8px 0 12px; }
  .ln-regs { margin-bottom: 8px; border-collapse: collapse; font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .ln-regs th, .ln-regs td { padding: 2px 8px 2px 0; border: 0; text-transform: none; letter-spacing: 0; white-space: nowrap; }
  .ln-regs th { font-family: var(--font-mono, ui-monospace, monospace); font-weight: 700; color: var(--color-gray-800); }
  .ln-hex { font-family: var(--font-mono, ui-monospace, monospace); }
  .ln-strip { display: flex; gap: 1px; }
  .ln-strip i { width: 4px; height: 12px; border-radius: 0; background: var(--color-gray-100); }
  .ln-strip i.b1 { background: var(--color-primary); }
  .ln-n { color: var(--color-muted); }
  .ln-grid { display: flex; flex-direction: column; gap: 3px; overflow-x: auto; }
  .ln-row { display: flex; gap: 3px; align-items: stretch; }
  .ln-cyc { min-width: 68px; font-size: 0.6875rem; line-height: 1.2; color: var(--color-muted); align-self: center; }
  .ln-cell { display: flex; flex-direction: column; justify-content: space-between; min-width: 40px; height: 36px; padding: 2px 3px; border-radius: 0; font-variant-numeric: tabular-nums; font-family: var(--font-mono, ui-monospace, monospace); background: var(--color-gray-100); color: var(--color-gray-500); }
  .ln-cell small { font-size: 0.5625rem; line-height: 1; }
  .ln-cell b { font-size: 0.75rem; text-align: right; font-weight: 600; }
  .ln-cell.off { background: repeating-linear-gradient(45deg, var(--color-gray-100), var(--color-gray-100) 3px, transparent 3px, transparent 6px); }
  .ln-cell.on { background: color-mix(in srgb, #3b82f6 30%, transparent); color: var(--color-text); }
  .ln-cell.then { background: color-mix(in srgb, #10b981 35%, transparent); color: var(--color-text); }
  .ln-cell.else { background: color-mix(in srgb, #f59e0b 38%, transparent); color: var(--color-text); }
  .ln-cap { margin-top: 4px; font-size: 0.75rem; color: var(--color-muted); }
</style>
