---
/**
 * Pick a GPU and a data NAD on the example node gpu-node-1: does net1's NIC sit next to the GPU?
 * Data: GPU/NIC pairing (sysfs paths, illustrative) via ./_topo and the per-node CNI files
 * (data-net-N → ensNnp0).
 */
import { pairs, podPair } from './_topo';
const nads = pairs.map((p) => ({ nad: p.nad, netdev: p.nic, rdma: p.rdma, numa: p.numa, socket: p.socket, switch: p.switch })).sort((a, b) => a.nad.localeCompare(b.nad));
const data = { pairs, nads };
---

<figure class="np" data-np={JSON.stringify(data)}>
  <figcaption class="np-title">Which NIC does net1 use, and is it next to my GPU? (gpu-node-1)</figcaption>
  <div class="np-in">
    <label>GPU from the claim <select data-k="gpu">{pairs.map((p) => <option value={p.gpu} selected={p.gpu === podPair.gpu}>{p.gpu}</option>)}</select></label>
    <label>NAD in the Pod annotation <select data-k="nad">{nads.map((n) => <option value={n.nad} selected={n.nad === podPair.nad}>{n.nad}</option>)}</select></label>
  </div>
  <div class="np-out">
    <div><span class="k">GPU</span><span class="v" data-o="g"></span></div>
    <div><span class="k">net1 parent NIC</span><span class="v" data-o="n"></span></div>
    <div><span class="k">Path between them</span><span class="v" data-o="p"></span></div>
  </div>
  <p class="np-note" data-o="note"></p>
</figure>

<style>
  .np { margin: 20px 0; padding: 16px 18px; border: 1px solid var(--color-gray-100); border-radius: 0; }
  .np-title { margin-bottom: 10px; font-weight: var(--font-weight-bold); }
  .np-in { display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.875rem; }
  .np-in label { display: flex; align-items: center; gap: 6px; }
  .np-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px 16px; margin-top: 14px; }
  .np-out div { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 0; background: var(--color-cloud-100); }
  .np-out .k { font-size: 0.75rem; color: var(--color-muted); }
  .np-out .v { font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .np-out .v.good { color: #40a02b; }
  .np-out .v.warn { color: #df8e1d; }
  .np-out .v.risk { color: #d20f39; }
  .np-note { margin-top: 8px; font-size: 0.875rem; }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-np]')) {
    const d = JSON.parse(fig.dataset.np!);
    const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const out = (k: string) => $<HTMLElement>(`[data-o=${k}]`);
    const update = () => {
      const g = d.pairs.find((p: any) => p.gpu === $<HTMLSelectElement>('[data-k=gpu]').value);
      const n = d.nads.find((x: any) => x.nad === $<HTMLSelectElement>('[data-k=nad]').value);
      out('g').textContent = `${g.gpu} · NUMA ${g.numa} · socket ${g.socket}`;
      out('n').textContent = `${n.netdev} (${n.rdma}) · NUMA ${n.numa} · socket ${n.socket}`;
      const p = out('p');
      if (n.switch === g.switch) { p.textContent = `same PCIe switch ${g.switch}`; p.className = 'v good'; }
      else if (n.socket === g.socket) { p.textContent = 'up through the CPU, same socket'; p.className = 'v warn'; }
      else { p.textContent = 'up through both CPUs (socket to socket)'; p.className = 'v risk'; }
      out('note').textContent = n.switch === g.switch
        ? `GPU and NIC hang off one switch: with GPU-direct RDMA, data the NIC reads from this GPU never reaches the CPU. ${g.gpu}'s neighbour NIC is ${g.nic}.`
        : `Traffic between ${g.gpu} and ${n.netdev} leaves the GPU's switch and crosses the CPU${n.socket === g.socket ? "'s internal fabric" : 's and the link between the sockets'}. The neighbour NIC of ${g.gpu} would be ${g.nic} (${g.nad}). Note: the NAD only decides net1; the RDMA NIC is the application's choice.`;
    };
    fig.querySelectorAll('select').forEach((el) => el.addEventListener('input', update));
    update();
  }
</script>
