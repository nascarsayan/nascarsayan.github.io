---
/** Pages (the home page): every article, newest first, or an empty state when there are none. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/hero/Hero.astro';
import RouteList from '@/components/ui/RouteList.astro';
import { ROUTES } from '@/config/routes';
import { SITE } from '@/config/site';

const articles = ROUTES.filter((r) => r.kind === 'article');
---

<BaseLayout>
  <Hero slot="hero">
    <Fragment slot="title">{SITE.title}</Fragment>
    <Fragment slot="lede">{SITE.description}</Fragment>
  </Hero>
  <div class="routes max-width-wrapper">
    <h2 class="visually-hidden">Pages</h2>
    {articles.length > 0 ? (
      <RouteList routes={articles} />
    ) : (
      <p class="empty">No pages yet. New notes will show up here; meanwhile, browse <a href="/learn/">Learn</a> or the <a href="/glossary/">Glossary</a>.</p>
    )}
  </div>
</BaseLayout>

<style>
  .routes { padding-top: 24px; padding-bottom: 40px; }
  .empty { max-width: 686px; color: var(--color-gray-700); }
</style>
