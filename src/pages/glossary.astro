---
/**
 * Glossary: every site-wide definition (src/config/glossary.ts), A to Z.
 * Hover or focus a term for its link icon; clicking it copies the link to that
 * definition (/glossary/#id), which opens with the entry highlighted.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/hero/Hero.astro';
import { GLOSSARY } from '@/config/glossary';

const entries = [...GLOSSARY].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
---

<BaseLayout title="Glossary" description="Terms used across this site, defined.">
  <Hero slot="hero">
    <Fragment slot="title">Glossary</Fragment>
    <Fragment slot="lede">Terms used across the site. In a page, the first use of each one is underlined; hover it for the definition.</Fragment>
  </Hero>
  <div class="glossary max-width-wrapper">
    <dl class="list">
      {entries.map((e) => (
        <div class="entry" id={e.id}>
          <dt>
            <a class="anchor" href={`#${e.id}`} data-copy-link aria-label={`Copy link to ${e.term}`} title="Copy link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
            </a>
            {e.term}{e.aliases?.length && <span class="aka"> · also {e.aliases.join(', ')}</span>}
            <span class="copied" aria-live="polite"></span>
          </dt>
          <dd>{e.definition}{e.links?.length && <span class="more"> {e.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>)}</span>}</dd>
        </div>
      ))}
    </dl>
  </div>
</BaseLayout>

<style>
  .glossary { padding-top: 24px; padding-bottom: 40px; }
  .list { display: flex; flex-direction: column; gap: 18px; max-width: 760px; margin: 0; }
  .entry { scroll-margin-top: calc(var(--header-height) + 24px); padding: 4px 0 4px 14px; border: 1px solid transparent; transition: border-color 200ms, background 200ms; }
  .entry:target { border-color: color-mix(in srgb, var(--color-primary) 40%, transparent); background: var(--color-info-background); border-radius: 0; }
  dt { position: relative; font-size: 1.125rem; font-weight: var(--font-weight-bold); }
  /* Link icon, like the heading anchors in articles: shown on hover or focus. */
  .anchor {
    position: absolute; top: 50%; left: -46px;
    display: grid; place-content: center; width: 28px; height: 28px;
    border-radius: 0; color: var(--color-gray-700);
    opacity: 0; transform: translate(4px, -50%);
    transition: opacity 0.3s, transform 0.3s var(--ease-out), color 150ms;
  }
  .entry:hover .anchor, .anchor:focus-visible { opacity: 0.85; transform: translate(0, -50%); }
  .anchor:hover { color: var(--color-primary); opacity: 1; }
  .copied { margin-left: 10px; font-size: 0.8125rem; font-weight: var(--font-weight-medium); color: var(--color-success); }
  .aka { font-size: 0.875rem; font-weight: var(--font-weight-light); color: var(--color-muted); }
  .more { font-size: 0.875rem; }
  .more a { color: var(--color-primary); }
  dd { margin: 2px 0 0; color: var(--color-gray-800); line-height: 1.55; }
  @media (max-width: 860px) { .anchor { position: static; display: inline-grid; transform: none; opacity: 0.6; margin-right: 4px; vertical-align: middle; } }
</style>

<script>
  // Copy the definition's link; the entry is highlighted as the URL's target.
  document.querySelectorAll<HTMLAnchorElement>('[data-copy-link]').forEach((a) => {
    a.addEventListener('click', async (e) => {
      e.preventDefault();
      const url = new URL(a.getAttribute('href')!, location.href).toString();
      location.hash = a.getAttribute('href')!; // highlights the entry (:target)
      const note = a.parentElement!.querySelector<HTMLElement>('.copied')!;
      try { await navigator.clipboard.writeText(url); note.textContent = 'Link copied'; }
      catch { note.textContent = url; }
      setTimeout(() => { note.textContent = ''; }, 2000);
    });
  });
</script>
